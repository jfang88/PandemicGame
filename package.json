{
  "name": "pandemic-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @pandemic/web\" \"npm run dev -w @pandemic/worker\"",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "vitest run packages",
    "build": "npm run build -w @pandemic/web && npm run build -w @pandemic/worker",
    "check:docs": "python3 scripts/validate_build_kit.py"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.30",
    "concurrently": "9.2.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.1.0"
  }
}

{
  "name": "pandemic-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @pandemic/web\" \"npm run dev -w @pandemic/worker\"",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/engine && tsc -p packages/protocol && tsc -p apps/web && tsc -p apps/worker && tsc -p tests/integration",
    "test:unit": "vitest run packages",
    "test:integration": "npm run build -w @pandemic/web && vitest run --config vitest.integration.config.ts",
    "dev:local-test": "npm run build -w @pandemic/web && npm run dev:local-test -w @pandemic/worker",
    "build": "npm run build -w @pandemic/web && npm run build -w @pandemic/worker",
    "check:docs": "python3 scripts/validate_build_kit.py && python3 scripts/test_validate_build_kit.py",
    "test:smoke": "node scripts/smoke-foundation.mjs",
    "test:auth-smoke": "node scripts/test-auth-popup.mjs",
    "test:connected-smoke": "node scripts/test-connected-room.mjs",
    "test:e2e": "node scripts/test-connected-room.mjs --full"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.30",
    "concurrently": "9.2.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.9.0"
}

{
  // Template only: T17 validates and promotes this to root wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pandemicgame-local",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "env": {
    "preview": {
      "name": "pandemicgame-preview",
      "durable_objects": {
        "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }]
      },
      "vars": {
        "APP_ENV": "preview",
        "ALLOWED_ORIGIN": "REPLACE_WITH_PREVIEW_HTTPS_ORIGIN",
        "FIREBASE_PROJECT_ID": "REPLACE_WITH_PREVIEW_FIREBASE_PROJECT_ID"
      }
    },
    "production": {
      "name": "pandemicgame-production",
      "durable_objects": {
        "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }]
      },
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGIN": "REPLACE_WITH_PRODUCTION_HTTPS_ORIGIN",
        "FIREBASE_PROJECT_ID": "REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID"
      }
    }
  }
}

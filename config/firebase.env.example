# Public frontend build configuration. Copy to ignored local env for the chosen environment.
# These must match FIREBASE_PROJECT_ID in the corresponding Worker environment.
VITE_FIREBASE_API_KEY=REPLACE_WITH_WEB_APP_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_APP_ID
# Never add OAuth client secrets, service-account private keys or emulator settings here.

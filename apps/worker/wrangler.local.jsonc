{
  // Foundation development and the production-like dry build use the normal entry.
  "name": "pandemic-game-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "dev": { "ip": "127.0.0.1", "inspector_port": 9230 },
  "vars": { "FIREBASE_PROJECT_ID": "local-placeholder-not-authenticated" },
  "durable_objects": { "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }, { "name": "CREATE_BUDGETS", "class_name": "CreateBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CreateBudget"] }]
}

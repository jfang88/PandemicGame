{
  // Loopback only. Use `npm run dev:local-test`; never deploy this entry.
  "name": "pandemic-game-local-test",
  "main": "src/local-test.ts",
  "compatibility_date": "2026-10-01",
  "dev": { "ip": "127.0.0.1" },
  "vars": {
    "FIREBASE_PROJECT_ID": "local-placeholder-not-authenticated",
    "APP_ORIGINS": "http://127.0.0.1:8787,http://127.0.0.1:5173"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/__test/*"]
  },
  "durable_objects": { "bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}

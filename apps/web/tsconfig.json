{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "composite": true,
    "resolveJsonModule": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "../../node_modules/.cache/web.tsbuildinfo"
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "../../packages/engine/src/*.ts",
    "../../spec/board.v1.json"
  ],
  "exclude": ["../../packages/engine/src/*.test.ts"]
}
